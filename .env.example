# Copy these names into .env.local and obtain the publishable key
# from this project's Supabase Dashboard > Settings > API Keys.
# NEXT_PUBLIC_* values are sent to browsers; use a publishable key only.
NEXT_PUBLIC_SUPABASE_URL=https://onfxxtvfprjnqsxdmhkp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_DASHBOARD_VALUE

# Server-only key for invite/recovery flow tickets; use at least 32 random bytes.
AUTH_FLOW_SIGNING_SECRET=REPLACE_WITH_RANDOM_SERVER_ONLY_SECRET

# Server-only canonical browser origin for all authentication form submissions.
# HTTP loopback is allowed only in development. Production requires HTTPS.
AUTH_TRUSTED_ORIGIN=http://localhost:3000

# Optional value-free cookie diagnostics. Disabled by default; accepted only in
# development on the exact localhost origin, outside managed/CI environments.
AUTH_COOKIE_DIAGNOSTICS=0

# Auth-flow RPC client (also required for fail-closed shared sign-in quotas). Never expose
# this to browsers; do not use the publishable key. Configure only after the
# new migration is approved and deployed to the target database.
SUPABASE_AUTH_STORE_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SECRET_KEY

# Server-only recovery mode: local (default), disabled, or hosted-local-test.
# Hosted testing additionally requires the exact origin below, a development-only
# server bound to loopback, same-project credentials, and working shared quotas.
# These examples do not enable hosted testing. Never set a NEXT_PUBLIC_ alias.
AUTH_RECOVERY_MODE=local
AUTH_RECOVERY_TEST_ORIGIN=
