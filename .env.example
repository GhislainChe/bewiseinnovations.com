# Copy these names into .env.local and obtain the publishable key
# from this project's Supabase Dashboard > Settings > API Keys.
# NEXT_PUBLIC_* values are sent to browsers; use a publishable key only.
NEXT_PUBLIC_SUPABASE_URL=https://onfxxtvfprjnqsxdmhkp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_DASHBOARD_VALUE

# Server-only key for invite/recovery flow tickets; use at least 32 random bytes.
AUTH_FLOW_SIGNING_SECRET=REPLACE_WITH_RANDOM_SERVER_ONLY_SECRET

# No secret/service-role key or database password is needed in Stage 2C.1.
